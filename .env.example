# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Change the model (default: gpt-4o)
# Recommended models:
# - gpt-4o (default) - Best balance, 128k context, 16k max output tokens
# - gpt-4-turbo - 128k context, 4096 max output tokens
# - gpt-4 - 8k context, 8192 max output tokens
# OPENAI_MODEL=gpt-4o
